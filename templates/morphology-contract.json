    },
    "crownDepth": {
      "region": "crown",
      "scope": "region",
      "effect": {"source":"mask","metric":"height","direction":"increase","minRelativeChange":0.05}
    },
    "appendageLength": {
      "region": "appendages",
      "scope": "region",
      "effect": {"source":"mask","metric":"height","direction":"increase","minRelativeChange":0.05}
    },
    "foldFrequency": {
      "region": "root",
      "scope": "surface",
      "effect": {"source":"image","metric":"visibleFraction","direction":"any","minRelativeChange":0.02}
    },
    "pulseStrength": {
      "region": "root",
      "scope": "global"
    }
  },
  "survivalFeatures": {
    "rootMass": {"mask":"masks/root.png","kind":"presence"},
    "appendageFamily": {"mask":"masks/appendages.png","kind":"presence"},
    "centralCavity": {"mask":"masks/cavity.png","kind":"void"}
