      "stages": [
        {"stage": 1, "name": "local validated controls", "classes": ["semantic-control", "local-deformation", "motion-phase", "surface-detail"]},
        {"stage": 2, "name": "contract-preserving structure", "classes": ["family-parameter", "attachment-parameter", "shared-projection", "shared-deformation"]},
        {"stage": 3, "name": "body-plan mutation", "classes": ["body-plan"], "experimental": true}
      ]
