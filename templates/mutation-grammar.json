        {"stage": 2, "name": "projection/deformation structure", "classes": ["projection-family", "deformation-operator", "time-coupling"]},
        {"stage": 3, "name": "broader recurrence variant", "classes": ["recurrence-family"]}
      ]
    },
    "sheet": {
