{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tsubuyaki-basin-confirmation-fallback",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 42
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"]
    }
  ],
  "workflows": [
    {
      "name": "tsubuyaki-basin-confirmation-v1",
      "binding": "CONFIRMATION_WORKFLOW",
      "class_name": "ConfirmationWorkflow"
    }
  ]
}
